# ============================================================
# .env.example — Copy this file to .env and fill in the values.
# NEVER commit your real .env file to Git.
# ============================================================

# --- Application Settings ---
APP_ENV=development          # development | production
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR

# --- WhatsApp Cloud API (Meta) --- [Module 2]
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id_here
WHATSAPP_WEBHOOK_VERIFY_TOKEN=choose_a_random_string_you_make_up

# --- LLM Provider --- [Module 4]
LLM_PROVIDER=openai           # openai | google | anthropic
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gpt-4o-mini

# --- Google Sheets --- [Module 3]
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=credentials/service_account.json
INVENTORY_SPREADSHEET_ID=your_inventory_sheet_id_here
INVENTORY_WORKSHEET_NAME=Sheet1
FAQ_SPREADSHEET_ID=your_faq_sheet_id_here
FAQ_WORKSHEET_NAME=Sheet1
ORDERS_SPREADSHEET_ID=your_orders_sheet_id_here
ORDERS_WORKSHEET_NAME=Orders
